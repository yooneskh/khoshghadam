{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.classAttributes": ["class", "ui"],
  "tailwindCSS.experimental.classRegex": [
    "(?:^|[\\s>\\{\\(])(?::|v-bind:)?[\\w-]*class[\\w-]*\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]"
  ]
}
